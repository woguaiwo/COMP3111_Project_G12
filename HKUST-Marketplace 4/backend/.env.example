# Public URL of the deployed Neon Function. This is safe to share with the client.
MARKETPLACE_API_URL=https://replace-with-your-neon-function-url

# Optional local JavaFX mode: api (default), jdbc, or demo.
# MARKETPLACE_MODE=demo

# Used only when deploying the function; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
