# Public Neon Data API URL. This is safe to share with the client.
MARKETPLACE_API_URL=https://<branch-endpoint>.apirest.<region>.aws.neon.tech/neondb/rest/v1
NEON_AUTH_URL=https://<branch-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth

# Optional local JavaFX mode: api (default), jdbc, or demo.
# MARKETPLACE_MODE=demo

# Used only by the legacy Function under backend/functions; never commit it.
JWT_SECRET=replace-with-a-long-random-secret
